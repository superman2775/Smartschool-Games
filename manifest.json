{
  "manifest_version": 3,
  "name": "Smartschool Games",
  "version": "1.1.0",
  "description": "Speel games in Smartschool!",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://*.smartschool.be/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.smartschool.be/*"],
      "js": ["main.js"],
      "run_at": "document_idle"
    }
  ]
}
